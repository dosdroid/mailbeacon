// Local credentials for the maintenance Wi-Fi access point.
//
// Copy this file to  src/secrets.h  and set your own values. src/secrets.h is
// listed in .gitignore, so your credentials never end up in a commit.
//
// Alternatively, define both macros from platformio.ini instead:
//   build_flags = -DOTA_AP_SSID='"MyMailbox"' -DOTA_AP_PASSWORD='"my-strong-pass"'
#pragma once

// Name of the Wi-Fi network the sensor creates in maintenance mode.
#define OTA_AP_SSID "Mailbox-OTA"

// WPA2 password for that network. Must be 8 to 63 characters.
// Anyone within Wi-Fi range who knows it can flash new firmware onto the
// sensor while maintenance mode is active, so pick something unique.
#define OTA_AP_PASSWORD "CHANGE-ME-before-flashing"
